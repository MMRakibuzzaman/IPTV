<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:IPTV.ViewModels"
             xmlns:models="using:IPTV.Models"
             xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="IPTV.Views.DesktopPlayerView"
             x:DataType="vm:PlayerViewModel"
             Background="Black">

    <UserControl.Styles>
        <!-- Sleek Player Control Button -->
        <Style Selector="Button.player-btn">
            <Setter Property="Background" Value="#1E1E2A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#323246" />
        </Style>
        <Style Selector="Button.player-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2D2D3E" />
            <Setter Property="BorderBrush" Value="#4A4A62" />
        </Style>

        <!-- Circular Action Button -->
        <Style Selector="Button.round-btn">
            <Setter Property="Background" Value="#6366F1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.round-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4F46E5" />
        </Style>

        <!-- Channel Item Style -->
        <Style Selector="Button.channel-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Transitions" Value="{x:Null}" />
        </Style>

        <!-- Quality Item Button Style -->
        <Style Selector="Button.quality-item-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style Selector="Button.quality-item-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#252538" />
        </Style>
        <Style Selector="Button.channel-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#222232" />
        </Style>
        <Style Selector="Button.channel-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A2A3E" />
        </Style>
    </UserControl.Styles>

    <Grid x:Name="RootGrid" Background="Black">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Player Area -->
        <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto">
            <!-- TOP BAR -->
            <Border Grid.Row="0"
                    Background="#12121A"
                    BorderBrush="#40222230"
                    BorderThickness="0,0,0,1"
                    Padding="16,8"
                    IsVisible="{Binding ShowControls}">
                <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                    <Button Grid.Column="0"
                            Classes="player-btn"
                            Command="{Binding GoBackCommand}"
                            ToolTip.Tip="Back to Playlists">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Viewbox Width="14" Height="14">
                                <Path Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"
                                      Fill="White" Stretch="Uniform" />
                            </Viewbox>
                            <TextBlock Text="Back" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveChannel.Name, FallbackValue='IPTV Stream'}"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding ActiveChannel.Group, FallbackValue=''}"
                                   Foreground="#9CA3AF"
                                   FontSize="11"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Classes="player-btn"
                            Width="40" Height="36"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip.Tip="Open Channel List (?)">
                        <Viewbox Width="20" Height="20">
                            <Path Data="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"
                                  Fill="White" Stretch="Uniform" />
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>

            <!-- Video Surface -->
            <vlc:VideoView x:Name="VideoView" 
                           Grid.Row="1"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           MediaPlayer="{Binding MediaPlayer}" />

            <!-- Transparent Controls Toggle Button -->
            <Button Grid.Row="1"
                    Background="Transparent"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{Binding ToggleControlsCommand}"
                    HotKey="Enter"
                    CornerRadius="0"
                    BorderThickness="0">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="Button:pressed /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </Button.Styles>
            </Button>

            <!-- BOTTOM BAR -->
            <Border Grid.Row="2"
                    Background="#12121A"
                    BorderBrush="#40222230"
                    BorderThickness="0,1,0,0"
                    Padding="24,16"
                    IsVisible="{Binding ShowControls}">
                <StackPanel Spacing="16">
                    <!-- Timeline / Scrubber -->
                    <Grid ColumnDefinitions="Auto, *, Auto" Margin="4,0" IsVisible="{Binding DurationSeconds}">
                        <TextBlock Grid.Column="0" Text="{Binding CurrentPositionText}" 
                                   FontSize="11" Foreground="#818CF8" FontWeight="Medium" VerticalAlignment="Center" />
                        
                        <Slider Grid.Column="1"
                                Margin="10,0"
                                Minimum="0"
                                Maximum="{Binding DurationSeconds}"
                                Value="{Binding CurrentPositionSeconds, Mode=TwoWay}" />

                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" 
                                   FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Bottom Action Controls -->
                    <Grid ColumnDefinitions="Auto, Auto, *, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Classes="player-btn" Width="34" Height="34" Padding="0"
                                    Command="{Binding PlayPreviousChannelCommand}" ToolTip.Tip="Previous Channel">
                                <Viewbox Width="14" Height="14">
                                    <Path Data="M6 6h2v12H6zm3.5 6l8.5 6V6z" Fill="White" Stretch="Uniform" />
                                </Viewbox>
                            </Button>

                            <Button Classes="round-btn" Width="40" Height="40"
                                    Command="{Binding TogglePlayPauseCommand}"
                                    ToolTip.Tip="Play / Pause">
                                <Panel>
                                    <Viewbox Width="14" Height="14" IsVisible="{Binding IsPlaying}">
                                        <Path Data="M6 19h4V5H6v14zm8-14v14h4V5h-4z" Fill="White" Stretch="Uniform" />
                                    </Viewbox>
                                    <Viewbox Width="14" Height="14" IsVisible="{Binding !IsPlaying}">
                                        <Path Data="M8 5v14l11-7z" Fill="White" Stretch="Uniform" />
                                    </Viewbox>
                                </Panel>
                            </Button>

                            <Button Classes="player-btn" Width="34" Height="34" Padding="0"
                                    Command="{Binding PlayNextChannelCommand}" ToolTip.Tip="Next Channel">
                                <Viewbox Width="14" Height="14">
                                    <Path Data="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z" Fill="White" Stretch="Uniform" />
                                </Viewbox>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="14,0,0,0" VerticalAlignment="Center">
                            <Viewbox Width="16" Height="16">
                                <Path Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"
                                      Fill="#9CA3AF" Stretch="Uniform" />
                            </Viewbox>
                            
                            <Slider Minimum="0" Maximum="1" Width="90"
                                    Value="{Binding Volume, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Button Classes="player-btn" Height="34" ToolTip.Tip="Stream Quality">
                                <TextBlock Text="{Binding SelectedQuality.Name, FallbackValue='Auto'}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                <Button.Flyout>
                                    <Flyout Placement="Top">
                                        <Border Background="#161622" BorderBrush="#2E2E42" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="130">
                                            <ItemsControl ItemsSource="{Binding AvailableQualities}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:StreamQuality">
                                                        <Button Classes="quality-item-btn" Click="OnQualityItemClick">
                                                            <Grid ColumnDefinitions="20, *">
                                                                <TextBlock Grid.Column="0" Text="✓" Foreground="#818CF8" FontWeight="Bold" FontSize="11" IsVisible="{Binding IsSelected}" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="White" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <Button Classes="player-btn" Height="34" Command="{Binding ToggleAspectCommand}" ToolTip.Tip="{Binding CurrentAspect, StringFormat='Aspect: {0}'}">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Viewbox Width="14" Height="14">
                                        <Path Data="M19 12h-2v3h-3v2h5v-5zM7 9h3V7H5v5h2V9zm14-6H3c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16.01H3V4.99h18v14.02z" Fill="White" Stretch="Uniform" />
                                    </Viewbox>
                                    <TextBlock Text="{Binding CurrentAspect}" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Classes="player-btn" Width="36" Height="34" Command="{Binding ToggleOrientationCommand}" ToolTip.Tip="Toggle Fullscreen">
                                <Panel>
                                    <Viewbox Width="15" Height="15" IsVisible="{Binding !IsFullscreen}">
                                        <Path Data="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z" Fill="White" Stretch="Uniform" />
                                    </Viewbox>
                                    <Viewbox Width="15" Height="15" IsVisible="{Binding IsFullscreen}">
                                        <Path Data="M5 16h3v3h2v-5H5v2zm3-8H5v2h5V5H8v3zm6 11h2v-3h3v-2h-5v5zm2-11V5h-2v5h5V8h-3z" Fill="White" Stretch="Uniform" />
                                    </Viewbox>
                                </Panel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- DESKTOP SIDEBAR OVERLAY -->
        <Grid Grid.Column="1" 
              Width="320"
              IsVisible="{Binding ShowDesktopSidebar}">
            <Border Background="#F212121A"
                    BorderBrush="#40222230"
                    BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto, *">
                    <!-- Sidebar Header with Search & Close -->
                    <StackPanel Grid.Row="0" Margin="14" Spacing="10">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding PlaylistTitle}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Classes="player-btn"
                                    Width="30" Height="30"
                                    Padding="0"
                                    Command="{Binding ToggleSidebarCommand}"
                                    ToolTip.Tip="Close Sidebar">
                                <TextBlock Text="✕" FontSize="13" Foreground="#9CA3AF" />
                            </Button>
                        </Grid>

                        <!-- Search Box & Filter -->
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBox Grid.Column="0" Text="{Binding SearchQuery, Mode=TwoWay}"
                                     PlaceholderText="Search channels..."
                                     CornerRadius="8"
                                     Height="36"
                                     Padding="10,6"
                                     Background="#1B1B27"
                                     BorderBrush="#2E2E42"
                                     Foreground="White">
                                <TextBox.InnerRightContent>
                                    <Button Command="{Binding ClearSearchCommand}"
                                            IsVisible="{Binding SearchQuery, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="4"
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="✕" FontSize="12" Foreground="#9CA3AF" />
                                    </Button>
                                </TextBox.InnerRightContent>
                            </TextBox>
                            <Button Grid.Column="1" Classes="player-btn" Margin="8,0,0,0" Width="36" Height="36" Padding="0"
                                    Command="{Binding CheckChannelsCommand}" ToolTip.Tip="Filter Working Channels">
                                <Panel>
                                    <TextBlock Text="↻" FontSize="16" Foreground="White" IsVisible="{Binding !IsCheckingChannels}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Text="..." FontSize="16" Foreground="White" IsVisible="{Binding IsCheckingChannels}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Panel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Channels and Categories Scrollable List -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding VisibleSidebarItems}" Margin="10,0,10,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SidebarItemViewModel">
                                    <Panel>
                                        <!-- Group Header -->
                                        <Button Classes="channel-btn"
                                                IsVisible="{Binding IsHeader}"
                                                Command="{Binding $parent[UserControl].((vm:PlayerViewModel)DataContext).ToggleGroupCommand}"
                                                CommandParameter="{Binding Name}"
                                                Background="#1C1C28"
                                                Margin="0,4,0,2">
                                            <Grid ColumnDefinitions="*, Auto" Width="270">
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" 
                                                           FontWeight="SemiBold" FontSize="13" Foreground="#818CF8" />
                                                <TextBlock Grid.Column="1" Text="▼" 
                                                           FontSize="10" Foreground="#818CF8" />
                                            </Grid>
                                        </Button>

                                        <!-- Channel Item -->
                                        <Button Classes="channel-btn"
                                                IsVisible="{Binding !IsHeader}"
                                                Command="{Binding $parent[UserControl].((vm:PlayerViewModel)DataContext).PlayChannelCommand}"
                                                CommandParameter="{Binding Channel}">
                                            <Grid ColumnDefinitions="Auto, *">
                                                <Border Grid.Column="0" Width="3" Height="14" CornerRadius="2" Background="#6366F1" Margin="0,0,8,0" IsVisible="{Binding IsActive}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Channel.Name, FallbackValue=''}" 
                                                           FontSize="13" 
                                                           Foreground="White"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </Panel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

